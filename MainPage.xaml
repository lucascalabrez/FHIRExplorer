<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FHIRExplorer.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="FHIR Explorer">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*"
        RowSpacing="12">

        <VerticalStackLayout Spacing="8">
            <Label
                Text="FHIR Explorer"
                FontSize="28"
                FontAttributes="Bold" />

            <Label Text="FHIR R4 server base URL" />

            <Entry
                x:Name="ServerUrlEntry"
                Text="https://hapi.fhir.org/baseR4"
                Keyboard="Url" />

            <Button
                Text="Load CapabilityStatement"
                Clicked="OnLoadCapabilityClicked" />

            <Label
                x:Name="CapabilityStatusLabel"
                Text="CapabilityStatement not loaded." />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="Resources"
                    FontSize="20"
                    FontAttributes="Bold" />

                <CollectionView
                    x:Name="ResourceCollectionView"
                    HeightRequest="180"
                    SelectionMode="Single"
                    SelectionChanged="OnResourceSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label
                                Padding="8"
                                Text="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label
                    x:Name="SelectedResourceLabel"
                    Text="Selected resource: none"
                    FontAttributes="Bold" />

                <Label Text="Supported interactions" />

                <Label
                    x:Name="InteractionsLabel"
                    Text="—" />

                <Label Text="Search parameter" />

                <Picker
                    x:Name="SearchParameterPicker"
                    Title="Select a search parameter" />

                <Label Text="Search value" />

                <Entry
                    x:Name="SearchValueEntry"
                    Placeholder="Enter only the parameter value" />

                <Button
                    x:Name="SearchButton"
                    Text="Search"
                    IsEnabled="False"
                    Clicked="OnSearchClicked" />

                <Label
                    x:Name="SearchStatusLabel"
                    Text="Select a resource and search parameter." />

                <Button
                    x:Name="ViewSearchsetJsonButton"
                    Text="View searchset JSON"
                    IsEnabled="False"
                    Clicked="OnViewSearchsetJsonClicked" />

                <Label
                    Text="Search results"
                    FontSize="20"
                    FontAttributes="Bold" />

                <CollectionView
                    x:Name="SearchResultCollectionView"
                    HeightRequest="300"
                    SelectionMode="Single"
                    SelectionChanged="OnSearchResultSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label
                                Padding="8"
                                Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
