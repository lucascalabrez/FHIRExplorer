<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FHIRExplorer.Pages.ResourceDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resource">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                x:Name="ResourceTitleLabel"
                Text="FHIR Resource"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                x:Name="StatusLabel"
                Text="Waiting for resource..." />

            <Editor
                x:Name="ResourceEditor"
                HeightRequest="400"
                IsReadOnly="True" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
